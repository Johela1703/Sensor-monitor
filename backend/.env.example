APP_NAME=Sensor Monitor API
APP_ENV=local
SQLALCHEMY_DATABASE_URI=mysql+pymysql://app:app@localhost:3306/sensordb
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPICS=sensor/temperature,sensor/humidity,sensor/voltage,sensor/current,sensor/pressure
THRESHOLDS_JSON={"temperature":{"min":0,"max":60},"humidity":{"min":10,"max":90},"voltage":{"min":2.5,"max":4.2},"current":{"min":0,"max":2.0},"pressure":{"min":90,"max":110}}
ALERT_LOOKBACK_HOURS=24
